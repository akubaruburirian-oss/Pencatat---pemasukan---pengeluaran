name: Rakit APK

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  rakit:
    runs-on: ubuntu-24.04
    steps:
      - name: Ambil kode
        uses: actions/checkout@v6

      - name: Pasang Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'

      - name: Simpan kunci tanda tangan
        uses: actions/cache@v5
        with:
          path: ~/.android/debug.keystore
          key: kunci-debug-v1

      - name: Pasang Gradle 8.10.2
        run: |
          wget -q https://services.gradle.org/distributions/gradle-8.10.2-bin.zip
          unzip -q gradle-8.10.2-bin.zip -d "$HOME"
          echo "$HOME/gradle-8.10.2/bin" >> "$GITHUB_PATH"

      - name: Rakit APK
        run: gradle assembleDebug --no-daemon -Dorg.gradle.jvmargs="-Xmx2g"

      - name: Terbitkan APK
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          cp app/build/outputs/apk/debug/app-debug.apk buku-kas.apk
          gh release create "build-${{ github.run_number }}" buku-kas.apk --title "Buku Kas build ${{ github.run_number }}" --notes "Unduh file buku-kas.apk lalu pasang di HP."
